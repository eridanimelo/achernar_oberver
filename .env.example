# Copie para `.env` e ajuste. Tudo tem default no compose,
# então o `.env` só é obrigatório se você fugir do padrão.
#   cp .env.example .env

# --- Postgres ---
POSTGRES_DB=achernar_observer
POSTGRES_USER=achernar
POSTGRES_PASSWORD=achernar
# Host port do banco. Padrão 5433 de propósito, porque a 5432 quase sempre
# já está ocupada por outro postgres. Use 5432 se preferir o padrão.
POSTGRES_PORT=5433

# --- Portas no host (altas de propósito, para não conflitar com outros projetos) ---
BACKEND_PORT=18080
FRONTEND_PORT=18180
OTLP_PORT=4318
# Porta do debug remoto (docker-compose.dev.yml)
DEBUG_PORT=5005

# --- Imagens ---
# Nome local após `docker compose build`. Para puxar imagens publicadas
# em vez de buildar, aponte para o registry (ex.: ghcr.io/<user>/observer-backend:1.4).
BACKEND_IMAGE=achernar-observer-backend:latest
FRONTEND_IMAGE=achernar-observer-frontend:latest

# --- Observer ---
# Only for a single-project LiteLLM instance; UNKNOWN for shared instances
OBSERVER_DEFAULT_PROJECT=UNKNOWN
OBSERVER_CAPTURE_PAYLOADS=true
OBSERVER_CAPTURE_HEADERS=true
OBSERVER_REDACT_SECRETS=true
OBSERVER_UPSTREAM=http://localhost:4000

# --- Avançado ---
# Para onde o collector encaminha OTLP. Default: http://backend:8080/otel
# (dentro do compose). Com backend fora do docker use:
# OTEL_EXPORTER_ENDPOINT=http://host.docker.internal:8080/otel
#OTEL_EXPORTER_ENDPOINT=http://backend:8080/otel
# JVM extra no container (o dev compose já define o JDWP de debug aqui)
#JAVA_OPTS=
